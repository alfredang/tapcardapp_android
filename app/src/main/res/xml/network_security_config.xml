<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain-HTTP (cleartext) only to local development hosts, so the app can
  reach a web backend running on your machine during local testing. Everything
  else (e.g. https://tapcard.tertiaryinfotech.com) stays HTTPS-only.

  Testing on a physical device? Add your PC's LAN IP as another <domain> below,
  e.g. <domain includeSubdomains="true">192.168.1.42</domain>
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.3.29</domain>
    </domain-config>
</network-security-config>